# Copy to .env.local and fill in. .env.local is gitignored; this file is not —
# never put real secrets here.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI scoring ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Stripe ---
# Pro is a one-time $40 lifetime purchase. The price is built inline at checkout
# (price_data), so there is NO product/price ID to configure.
# Dashboard → Developers → API keys (test mode). Starts with sk_test_.
STRIPE_SECRET_KEY=
# Webhook signing secret. Local: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints it. Deployed: Dashboard →
# Developers → Webhooks → your endpoint → Signing secret. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# Canonical origin for Stripe Checkout/Portal return URLs. Optional — derived
# from the incoming request when unset, which is correct for local dev and
# preview deploys. Set it on the production deploy.
NEXT_PUBLIC_SITE_URL=
